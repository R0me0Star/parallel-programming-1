{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build C++14 Parallel Sum",
      "type": "shell",
      "command": "g++",
      "args": [
        "-std=c++14",
        "-Wall",
        "-Wextra",
        "-Wold-style-cast",
        "-pthread",
        "${fileDirname}/main.cpp",
        "-o",
        "${fileDirname}/main"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    }
  ]
}